{
  "name": "plumd",
  "version": "0.2.6",
  "description": "Editor y visor de Markdown con cinta tipo Word y plugins",
  "main": "src/main/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test \"tests/*.test.js\"",
    "start": "node scripts/build.js && electron .",
    "watch": "node scripts/build.js --watch",
    "dist": "node scripts/build.js && electron-builder --win nsis portable"
  },
  "author": "Jorge Ferreira Rey",
  "homepage": "https://github.com/jfr1504/pluMd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfr1504/pluMd.git"
  },
  "bugs": {
    "url": "https://github.com/jfr1504/pluMd/issues"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "codemirror": "^6.0.2"
  },
  "productName": "PluMd",
  "private": true,
  "build": {
    "appId": "com.plumd.app",
    "productName": "PluMd",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "src/main/**",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "fileAssociations": [
        {
          "ext": "md",
          "name": "Documento Markdown",
          "description": "Documento Markdown",
          "role": "Editor"
        },
        {
          "ext": "markdown",
          "name": "Documento Markdown",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "artifactName": "PluMd-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "PluMd-portable-${version}.exe"
    }
  }
}
